def merge_sort_iterative(a):
    n = len(a)
    comparisons = 0
    assignments = 0
    i = 1
    assignments += 1 # i = 1

    while i < n:
        # comparisons += 1 # Порівняння (while i < n)
        j = 0
        assignments += 1 # j = 0
        
        while j < n - i:
            # comparisons += 1 # Порівняння (while j < n - i)
            left = j
            mid = j + i
            right = min(j + 2 * i, n)
            assignments += 3 # left=, mid=, right=
            
            # Отримуємо підрахунки з функції merge
            c, a_count = merge(a, left, mid, right)
            comparisons += c
            assignments += a_count
            
            j += 2 * i
            assignments += 1 # j += ...
        
        i *= 2
        assignments += 1 # i *= ...
        
    return a, comparisons, assignments


def merge(a, left, mid, right):
    comparisons = 0
    assignments = 0
    
    L = a[left:mid]
    assignments += 1 # L = ...
    R = a[mid:right]
    assignments += 1 # R = ...
    
    n1, n2 = len(L), len(R)
    assignments += 2 # n1 = ..., n2 = ...

    i = j = 0
    assignments += 2 # i = 0, j = 0
    k = left
    assignments += 1 # k = left

    # Основний цикл злиття
    while i < n1 and j < n2:
        comparisons += 1
        if L[i] <= R[j]:
            a[k] = L[i]
            i += 1
            assignments += 2 # a[k]=, i+=
        else:
            a[k] = R[j]
            j += 1
            assignments += 2 # a[k]=, j+=
        k += 1
        assignments += 1 # k+=

    # Копіювання залишків L
    while i < n1:
        a[k] = L[i]
        i += 1
        k += 1
        assignments += 3 # a[k]=, i+=, k+=

    while j < n2:
        a[k] = R[j]
        j += 1
        k += 1
        assignments += 3 # a[k]=, j+=, k+=

    return comparisons, assignments


my_list = [21, 44, 22, 50, 63, 68, 97, 12, 15]
print("Оригінальний список:", my_list)

sorted_list, comps, assigns = merge_sort_iterative(my_list.copy())

print("Відсортований список:", sorted_list)
# ВИПРАВЛЕНО: 'comgns' -> 'comps'
print(f"Кількість порівнянь: {comps}")
# ДОДАНО: Виведення присвоєнь
print(f"Кількість присвоєнь: {assigns}")
